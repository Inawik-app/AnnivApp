{
  "name": "gp-party",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "cross-env NODE_ENV=production tsx server/index.ts",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "tsx tests/e2e.ts",
    "test:tv": "tsx tests/tv.ts",
    "simulation": "tsx scripts/simuler.ts",
    "simulation:balayage": "tsx scripts/balayage-equilibrage.ts",
    "icones": "node scripts/decouper-icones.mjs"
  },
  "browserslist": [
    "chrome >= 38",
    "safari >= 9"
  ],
  "dependencies": {
    "express": "^4.21.2",
    "immer": "^10.1.1",
    "nanoid": "^5.1.5",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@fontsource/baloo-2": "^5.3.0",
    "@fontsource/dotgothic16": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "@preact/preset-vite": "^2.10.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.15.21",
    "@types/qrcode": "^1.5.5",
    "@vitejs/plugin-legacy": "^6.1.1",
    "autoprefixer": "^10.4.21",
    "cross-env": "^7.0.3",
    "playwright": "^1.63.0",
    "pngjs": "^7.0.0",
    "preact": "^10.26.6",
    "socket.io-client": "^4.8.1",
    "terser": "^5.40.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.4"
  }
}
